{
  "expo": {
    "name": "BudgetNest",
    "slug": "budgetnest-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "budgetnest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dsaldariega.budgetnest"
    },
    "android": {
      "package": "com.dsaldariega.budgetnest",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
